# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Database
DB_PATH=./data/attendance.db

# Fingerprint Device
FINGERPRINT_IP=192.168.1.102
FINGERPRINT_PORT=4370
FINGERPRINT_TIMEOUT=10000
POLLING_INTERVAL=30000

# WAHA Configuration
WAHA_URL=http://192.168.1.180:5555
WAHA_API_KEY=your_api_key_here
WAHA_SESSION=default

# Admin Alert
ADMIN_WHATSAPP=628XXXXXXXXXX

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# CORS (for development)
CLIENT_URL=http://localhost:3000

# Rate limiting — antrean API per IP. Naikkan bila dashboard kena
# "too many requests" (dashboard mem-ping beberapa endpoint tiap 30 detik).
RATE_LIMIT_WINDOW_MS=900000      # jendela (ms); default 15 menit
RATE_LIMIT_MAX=1000              # max permintaan per jendela; default 1000
# Whitelist IP (koma) yang dibebaskan — mendukung wildcard, mis.
# 127.0.0.1,192.168.1.* ; atau '*' utk menonaktifkan rate limit.
RATE_LIMIT_WHITELIST=127.0.0.1

# Percayai reverse proxy (nginx/CasaOS) utk membaca IP client nyata.
TRUST_PROXY=0

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAYS=60000,300000,900000
