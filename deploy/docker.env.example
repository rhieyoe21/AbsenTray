# Contoh env untuk docker-compose — salin sebagai `.env` di folder ini saat deploy:
#   cp deploy/docker.env.example .env   (lalu edit)
# Semua variabel punya default di docker-compose.yml; berisi nilai yang WAJIB disesuaikan.

# Device fingerprint
FINGERPRINT_IP=192.168.1.102
FINGERPRINT_PORT=4370
FINGERPRINT_TIMEOUT=10000
POLLING_INTERVAL=30000

# WAHA WhatsApp API
WAHA_URL=http://192.168.1.180:5555
WAHA_API_KEY=your_waha_api_key
WAHA_SESSION=default

# Alerta admin — nomor internasional tanpa "0"
ADMIN_WHATSAPP=628XXXXXXXXXX

# CORS: '*' = izinkan semua origin; atau origin spesifik utk produksi (mis. http://192.168.1.180:5000)
CLIENT_URL=*